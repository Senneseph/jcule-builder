{
  "name": "jcule-builder",
  "version": "1.0.0",
  "description": "Visual builder for creating UIs from OpenAPI specifications using jellicule components",
  "main": "dist/index.js",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "axios": "^1.4.0",
    "jsonpath-plus": "^7.2.0",
    "monaco-editor": "^0.40.0",
    "openapi-types": "^12.1.0",
    "yaml": "^2.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.4.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.44.0",
    "typescript": "^5.1.6",
    "vite": "^4.4.4",
    "vitest": "^0.33.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webax/jcule-builder.git"
  },
  "keywords": [
    "jcule",
    "jellicule",
    "openapi",
    "swagger",
    "ui",
    "builder",
    "visual",
    "drag-and-drop"
  ],
