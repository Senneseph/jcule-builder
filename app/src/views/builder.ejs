<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="container">
        <h1>PWA Builder</h1>
        <form id="pwaForm">
            <section class="basic-config">
                <h2>Basic PWA Configuration</h2>
                <div class="form-group">
                    <label for="appName">App Name</label>
                    <input type="text" id="appName" name="name" required>
                </div>
                <div class="form-group">
                    <label for="shortName">Short Name</label>
                    <input type="text" id="shortName" name="shortName" required>
                </div>
                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" name="description" required></textarea>
                </div>
            </section>

            <section class="theme-customization">
                <h2>Theme Customization</h2>
                <div class="form-group">
                    <label for="primaryColor">Primary Color</label>
                    <input type="color" id="primaryColor" name="themeColor" required>
                </div>
                <div class="form-group">
                    <label for="backgroundColor">Background Color</label>
                    <input type="color" id="backgroundColor" name="backgroundColor" required>
                </div>
            </section>

            <button type="submit">Generate PWA</button>
        </form>
    </div>
    <script src="/js/builder.js"></script>
</body>
</html>